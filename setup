#!/bin/bash

# Link dotiles to home directory

mkdir -p ~/.config

create_links() {
	local src="$1"
	local dest="$2"
	ln -sf "$src" "$dest"
	echo "Linked: $dest"
}

dotfiles=("vimrc" "bashrc" "tmux.conf")
for file in "${dotfiles[@]}"; do
	create_links "$HOME/dotfiles/$file" "$HOME/.file"
done

ln -sf ~/dotfiles/starship.toml ~/.config/starship.toml
ln -sf ~/dotfiles/config.ghostty ~/.config/ghostty/config.ghostty
ln -sf ~/dotfiles/hyprland.lua ~/.config/hypr/hyprland.lua

echo "Dotfiles linked"
